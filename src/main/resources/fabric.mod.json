{
	"schemaVersion": 1,
	"id": "minedew-fishing",
	"version": "${version}",
	"name": "Minedew Fishing",
	"description": "A Stardew Valley-style fishing minigame for Minecraft",
	"authors": [
		"justfatlard"
	],
	"license": "MIT",
	"icon": "assets/minedew-fishing/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.minedew.fishing.MinedewFishing"
		]
	},
	"mixins": [
		"minedew-fishing.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=15.0.0"
	},
	"suggests": {
		"village-quests-justfatlard": "*"
	},
	"contact": {
		"homepage": "https://github.com/fatlard1993/minedew-fishing",
		"sources": "https://github.com/fatlard1993/minedew-fishing",
		"issues": "https://github.com/fatlard1993/minedew-fishing/issues"
	}
}
